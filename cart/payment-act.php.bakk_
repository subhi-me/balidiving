<?php
// /cart/payment-act.php  (HTML Invoice)
// SINGLE SOURCE OF TRUTH: inv_get_invoice() from /cart/_invoice-lib.php
declare(strict_types=1);
date_default_timezone_set('Asia/Makassar');

require __DIR__ . '/../template/database/main-cart.php';
require __DIR__ . '/_invoice-lib.php';

$bookingId = trim((string)($_GET['booking_id'] ?? ''));
if ($bookingId === '') {
  header("Location: https://balidiving.com/cart/my-booking");
  exit;
}

try {
  $inv = inv_get_invoice($pdo, $bookingId);
} catch (Throwable $e) {
  header("Location: https://balidiving.com/cart/my-booking");
  exit;
}

$customer = $inv['customer'];
$meta = $inv['meta'];
$lines = $inv['lines'];
$totals = $inv['totals'];

$issued = $meta['created_at'] ? date('d M Y H:i', strtotime($meta['created_at'])) . " (Bali time)" : date('d M Y H:i') . " (Bali time)";
$pdfUrl = "/cart/invoice-pdf.php?booking_id=" . urlencode($inv['booking_id']);
?>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Invoice <?= inv_h($inv['booking_id']) ?></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @media print { .no-print{display:none!important} body{background:#fff!important} .print-flat{box-shadow:none!important} }
  </style>
</head>
<body class="bg-slate-50 text-slate-900">
  <div class="max-w-4xl mx-auto px-4 py-6">
    <div class="flex items-start justify-between gap-3 mb-4">
      <div>
        <div class="text-2xl font-extrabold tracking-tight">Bali Diving</div>
        <div class="text-sm text-slate-600">balidiving.com</div>
        <div class="mt-3 text-lg font-extrabold">Invoice</div>
        <div class="text-sm text-slate-600">Booking ID: <span class="font-extrabold"><?= inv_h($inv['booking_id']) ?></span></div>
        <div class="text-sm text-slate-600">Issued: <?= inv_h($issued) ?></div>
      </div>
      <div class="text-right">
        <div class="inline-flex flex-col gap-1 rounded-2xl bg-white ring-1 ring-slate-200 px-4 py-3 print-flat">
          <div class="text-xs text-slate-500 font-semibold">Payment Status</div>
          <div class="text-lg font-extrabold"><?= inv_h($meta['payment_status']) ?></div>
        </div>
        <div class="mt-2 flex gap-2 justify-end no-print">
          <a href="<?= inv_h($pdfUrl) ?>" target="_blank" rel="noopener noreferrer"
             class="px-3 py-2 rounded-xl bg-slate-900 text-white text-sm font-extrabold hover:bg-slate-800">Open PDF</a>
          <button onclick="window.print()" class="px-3 py-2 rounded-xl bg-white ring-1 ring-slate-200 text-sm font-extrabold hover:bg-slate-50">Print</button>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-2xl ring-1 ring-slate-200 p-4 mb-4 print-flat">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <div class="text-xs text-slate-500 font-semibold">Guest</div>
          <div class="text-base font-extrabold mt-1"><?= inv_h($customer['name']) ?></div>
          <div class="text-sm text-slate-700"><?= inv_h($customer['email']) ?></div>
        </div>
        <div>
          <div class="text-xs text-slate-500 font-semibold">Details</div>
          <div class="text-sm text-slate-700 mt-1">Phone/WhatsApp: <span class="font-extrabold"><?= inv_h($customer['phone']) ?></span></div>
          <div class="text-sm text-slate-700">Certificate Level: <span class="font-extrabold"><?= inv_h($customer['certificate_level']) ?></span></div>
          <div class="text-sm text-slate-700">FX Rate: <span class="font-extrabold"><?= $meta['fx_rate'] > 0 ? number_format((float)$meta['fx_rate'], 0) : '-' ?></span></div>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-2xl ring-1 ring-slate-200 overflow-hidden mb-4 print-flat">
      <div class="px-4 py-3 border-b border-slate-200 font-extrabold">Items</div>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead class="bg-slate-50 text-slate-600">
            <tr>
              <th class="text-left px-4 py-3 font-extrabold">Item</th>
              <th class="text-right px-4 py-3 font-extrabold">Qty</th>
              <th class="text-right px-4 py-3 font-extrabold">Line (USD)</th>
              <th class="text-right px-4 py-3 font-extrabold">Line (IDR)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <?php if (!$lines): ?>
              <tr><td colspan="4" class="px-4 py-8 text-center text-slate-500">No items.</td></tr>
            <?php else: ?>
              <?php foreach ($lines as $ln): ?>
                <tr>
                  <td class="px-4 py-3">
                    <div class="font-extrabold"><?= inv_h($ln['product_name']) ?></div>
                    <?php if (!empty($ln['addons_text'])): ?>
                      <div class="text-xs text-slate-500 font-semibold mt-1"><?= inv_h($ln['addons_text']) ?></div>
                    <?php endif; ?>
                  </td>
                  <td class="px-4 py-3 text-right font-extrabold"><?= (int)$ln['qty'] ?></td>
                  <td class="px-4 py-3 text-right font-extrabold"><?= inv_h(inv_money_usd((float)$ln['line_usd'])) ?></td>
                  <td class="px-4 py-3 text-right font-extrabold">
                    <?= ($meta['fx_rate'] > 0) ? inv_h(inv_money_idr((float)$ln['line_idr'])) : '-' ?>
                  </td>
                </tr>
              <?php endforeach; ?>
            <?php endif; ?>
          </tbody>
        </table>
      </div>
    </div>

    <div class="bg-white rounded-2xl ring-1 ring-slate-200 p-4 print-flat">
      <div class="flex items-start justify-between gap-4">
        <div class="text-xs text-slate-500 leading-relaxed">
          Thank you for booking with Bali Diving. Please keep this invoice for your records.
        </div>
        <div class="text-right">
          <div class="text-xs text-slate-500 font-semibold">Total</div>
          <div class="text-2xl font-extrabold"><?= inv_h(inv_money_usd((float)$totals['total_usd'])) ?></div>
          <div class="text-base font-extrabold text-slate-900">
            <?= ($meta['fx_rate'] > 0) ? inv_h(inv_money_idr((float)$totals['total_idr'])) : 'IDR total not available' ?>
          </div>
        </div>
      </div>
      <div class="mt-3 text-[11px] text-slate-400">
        Generated automatically • balidiving.com • Booking ID: <?= inv_h($inv['booking_id']) ?>
      </div>
    </div>
  </div>
</body>
</html>
